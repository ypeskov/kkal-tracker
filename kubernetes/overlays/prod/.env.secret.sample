#.env.secret.prod.sample
# Sensitive settings, generated into the kkal-tracker-secrets Secret.

# JWT secret key: at least 32 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=a-very-secret-key

# SMTP password (for Gmail: an App Password)
SMTP_PASSWORD="XXXX YYYY XXXX YYYY"

# OpenAI API key (optional, enables AI insights)
OPENAI_API_KEY=

# Google Drive OAuth token for backups; generate with rclone: https://rclone.org/drive/
GDRIVE_OAUTH_TOKEN={"access_token"}
